{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/events/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/event-qr/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/admin/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/payments/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/registrations/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/data/(.*)",
      "destination": "/data/$1"
    },
    {
      "source": "/pages/(.*)",
      "destination": "/$1"
    }
  ]
}
